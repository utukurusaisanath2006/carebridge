# Anthropic API Key (Required for live Claude calls)
# Leave blank to automatically use the high-fidelity offline rule-based parser
ANTHROPIC_API_KEY=

# Model identifier (default: claude-sonnet-4-6)
# Options: claude-sonnet-4-6, claude-3-7-sonnet-20250219, claude-3-5-sonnet-20241022
ANTHROPIC_MODEL=claude-sonnet-4-6

# Server configuration
PORT=8000
HOST=127.0.0.1

# JWT Secret for Session & Role-Based Access Control
JWT_SECRET=replace_with_a_secure_random_secret_in_production
